<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/TextAppearance.LiveWeather.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/more_title" />

        <TextView
            style="@style/TextAppearance.LiveWeather.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/more_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_weather_card_accent"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/city_manager_title" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/city_manager_subtitle" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/city_active_label"
                android:textColor="@color/weather_aqua" />

            <TextView
                android:id="@+id/cityActiveLocation"
                style="@style/TextAppearance.LiveWeather.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/city_active_current"
                android:textColor="@color/weather_text_primary" />

            <TextView
                android:id="@+id/cityUseCurrentButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_weather_chip"
                android:gravity="center"
                android:text="@string/city_use_current"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/citySearchInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_weather_card_compact"
                    android:hint="@string/city_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:paddingStart="@dimen/space_14"
                    android:paddingEnd="@dimen/space_14"
                    android:singleLine="true"
                    android:textColor="@color/weather_text_primary"
                    android:textColorHint="@color/weather_text_tertiary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/citySearchButton"
                    android:layout_width="86dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_weather_button_primary"
                    android:gravity="center"
                    android:text="@string/city_search"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/citySearchStatus"
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/city_search_hint_status" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/city_search_results_title" />

            <LinearLayout
                android:id="@+id/citySearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_18"
                android:text="@string/city_saved_title" />

            <LinearLayout
                android:id="@+id/citySavedList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LiveWeather.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/more_tools_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/moreWidgetsAction"
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_widgets" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/more_widgets_sub" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_alerts" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/more_alerts_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_air_quality" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/more_air_quality_sub" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="104dp"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/more_units" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/more_units_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:background="@drawable/bg_weather_card_compact"
            android:orientation="vertical"
            android:padding="@dimen/space_14">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/more_performance" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/more_performance_sub" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_weather_card_accent"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/more_about" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/more_about_phase_three" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LiveWeather.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/status_phase_three"
            android:textColor="@color/weather_sky_blue" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

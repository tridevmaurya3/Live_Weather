<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/TextAppearance.LiveWeather.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallpaper_title" />

        <TextView
            style="@style/TextAppearance.LiveWeather.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/wallpaper_subtitle" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_weather_wallpaper_preview"
            android:clipToOutline="true">

            <com.tridev.liveweather.ui.sky.LiveSkyView
                android:id="@+id/wallpaperLiveSkyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/wallpaper_preview_label"
                    android:textColor="@color/weather_aqua"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wallpaperPreviewTemperature"
                    style="@style/TextAppearance.LiveWeather.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="@string/home_temperature_placeholder" />

                <TextView
                    android:id="@+id/wallpaperPreviewCondition"
                    style="@style/TextAppearance.LiveWeather.BodyLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="@string/wallpaper_preview_waiting" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/wallpaperCelestialSummary"
            style="@style/TextAppearance.LiveWeather.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:text="@string/phase6_celestial_waiting"
            android:textColor="@color/weather_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_weather_card_accent"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/wallpaper_reality_sync_title" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/wallpaper_reality_sync_body" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LiveWeather.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/wallpaper_effects_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:background="@drawable/bg_weather_card_compact"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_10"
            android:paddingBottom="@dimen/space_8">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchRainParticles"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_rain"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCloudMovement"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_clouds"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLightning"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_lightning"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSnow"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_snow"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchFog"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_fog"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchStars"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_stars"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchBatteryAdaptive"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:checked="true"
                android:text="@string/wallpaper_effect_battery"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/applyWallpaperButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_weather_button_primary"
            android:gravity="center"
            android:text="@string/wallpaper_apply"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            style="@style/TextAppearance.LiveWeather.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:gravity="center"
            android:text="@string/wallpaper_note"
            android:textAlignment="center" />

        <TextView
            style="@style/TextAppearance.LiveWeather.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_14"
            android:text="@string/status_real_nature_engine"
            android:textColor="@color/weather_aqua" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

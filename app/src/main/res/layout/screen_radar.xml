<?xml version="1.0" encoding="utf-8"?>
<com.tridev.liveweather.ui.radar.RadarPageLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_12">

    <TextView
        style="@style/TextAppearance.LiveWeather.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Weather Radar" />

    <TextView
        style="@style/TextAppearance.LiveWeather.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:text="Observed precipitation radar + current model cloud, wind and temperature field" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:background="@drawable/bg_weather_card_compact"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.10"
                android:text="ACTIVE MAP LOCATION"
                android:textColor="@color/weather_aqua"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/radarLocationValue"
                style="@style/TextAppearance.LiveWeather.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Waiting for location…" />

            <TextView
                android:id="@+id/radarStatusValue"
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Radar loads when this tab becomes visible." />
        </LinearLayout>

        <TextView
            android:id="@+id/radarRefreshButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_weather_chip"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:text="Refresh"
            android:textColor="@color/weather_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/radarMapHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_10"
        android:layout_weight="1"
        android:background="@drawable/bg_weather_radar_preview"
        android:clipToOutline="true"
        android:minHeight="260dp">

        <TextView
            android:id="@+id/radarRecenterButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_10"
            android:background="@drawable/bg_weather_chip"
            android:gravity="center"
            android:minWidth="82dp"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:text="Recenter"
            android:textColor="@color/weather_text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/radarLegendCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/space_10"
            android:background="@drawable/bg_weather_glass_panel"
            android:maxWidth="320dp"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_10"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_10"
            android:paddingBottom="@dimen/space_8">

            <TextView
                android:id="@+id/radarLegendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="OBSERVED RAIN RADAR"
                android:textColor="@color/weather_aqua"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/radarLegendBody"
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:text="Light → Moderate → Heavy → Intense echoes"
                android:textColor="@color/weather_text_primary" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/radarLayerRain"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_weather_chip"
                android:gravity="center"
                android:minWidth="94dp"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="Rain Radar"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/radarLayerClouds"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_weather_chip"
                android:gravity="center"
                android:minWidth="108dp"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="Model Clouds"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/radarLayerWind"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_weather_chip"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="Wind"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/radarLayerTemp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/space_8"
                android:background="@drawable/bg_weather_chip"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="Temperature"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_10"
        android:background="@drawable/bg_weather_card_compact"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/radarPlayButton"
                android:layout_width="78dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_weather_chip"
                android:gravity="center"
                android:text="Replay"
                android:textColor="@color/weather_text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/radarTimelineSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:maxLines="2"
                android:text="Latest observed frame"
                android:textColor="@color/weather_text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/radarFrameTimeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:text="--:-- UTC"
                android:textColor="@color/weather_aqua"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/radarTimelineSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:contentDescription="Observed radar history timeline"
            android:max="0"
            android:progress="0" />
    </LinearLayout>

    <TextView
        android:id="@+id/radarSourceValue"
        style="@style/TextAppearance.LiveWeather.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:background="@drawable/bg_weather_card_compact"
        android:gravity="center_horizontal"
        android:padding="@dimen/space_8"
        android:text="RainViewer observed radar • Open-Meteo model overlays • OpenStreetMap base"
        android:textAlignment="center"
        android:textColor="@color/weather_text_primary" />

</com.tridev.liveweather.ui.radar.RadarPageLayout>

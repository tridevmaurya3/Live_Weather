<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <TextView
            style="@style/TextAppearance.LiveWeather.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/radar_title" />

        <TextView
            style="@style/TextAppearance.LiveWeather.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/radar_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:layout_marginTop="@dimen/space_16"
            android:background="@drawable/bg_weather_radar_preview"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="@string/radar_map_label"
                android:textColor="@color/weather_aqua"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                style="@style/TextAppearance.LiveWeather.BodyLarge"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center"
                android:text="@string/radar_map_waiting"
                android:textAlignment="center" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/radar_layer_rain"
                    android:textColor="@color/weather_text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/radar_layer_clouds"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/radar_layer_temp"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/radar_layer_wind"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_weather_card_compact"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/radar_timeline_title" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/radar_timeline_waiting" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LiveWeather.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/status_phase_one"
            android:textColor="@color/weather_sky_blue" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
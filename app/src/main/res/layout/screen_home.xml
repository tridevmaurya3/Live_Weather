<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:paddingBottom="@dimen/space_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/home_brand"
            android:textColor="@color/weather_aqua"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/home_location_label"
            android:textColor="@color/weather_text_tertiary"
            android:textSize="@dimen/text_caption" />

        <TextView
            style="@style/TextAppearance.LiveWeather.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/home_location_waiting" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_weather_card_accent"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <TextView
                style="@style/TextAppearance.LiveWeather.Temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/home_temperature_placeholder" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/home_condition_waiting" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_feels_like" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:text="@string/home_high_low" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/home_sync_status" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:minHeight="@dimen/metric_card_min_height"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_humidity" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.MetricValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/metric_placeholder" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:layout_marginEnd="@dimen/space_2"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:minHeight="@dimen/metric_card_min_height"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_wind" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.MetricValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/metric_placeholder" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:minHeight="@dimen/metric_card_min_height"
                android:orientation="vertical"
                android:padding="@dimen/space_12">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_rain" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.MetricValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:text="@string/metric_placeholder" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LiveWeather.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/section_hourly" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/hour_now"
                    android:textColor="@color/weather_text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/hour_plus_1"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/hour_plus_2"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/hour_plus_3"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/hour_plus_4"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/space_8"
                    android:background="@drawable/bg_weather_chip"
                    android:gravity="center"
                    android:text="@string/hour_plus_5"
                    android:textColor="@color/weather_text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            style="@style/TextAppearance.LiveWeather.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:text="@string/section_today_details" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:background="@drawable/bg_weather_card_compact"
            android:orientation="vertical"
            android:padding="@dimen/space_14">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quick_ten_day" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/quick_ten_day_sub" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_radar" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/quick_radar_sub" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:background="@drawable/bg_weather_card_compact"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    style="@style/TextAppearance.LiveWeather.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_air" />

                <TextView
                    style="@style/TextAppearance.LiveWeather.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/quick_air_sub" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_weather_wallpaper_preview"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <TextView
                style="@style/TextAppearance.LiveWeather.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_wallpaper_title" />

            <TextView
                style="@style/TextAppearance.LiveWeather.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:text="@string/home_wallpaper_body" />

            <TextView
                android:id="@+id/homeWallpaperAction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="@dimen/space_14"
                android:background="@drawable/bg_weather_button_primary"
                android:gravity="center"
                android:text="@string/home_wallpaper_action"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.LiveWeather.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/status_phase_one"
            android:textColor="@color/weather_sky_blue" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
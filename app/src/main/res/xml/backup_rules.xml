<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Live Weather stores active/saved coordinates, weather/AQI caches,
        alert fingerprints and rendering preferences locally. Production builds
        do not place this state into Android cloud/device backups.
    -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
